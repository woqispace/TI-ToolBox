{
  "app": {
    "title": "TI工具箱",
    "version": "1.1.3",
    "beta": true
  },
  "vars": {
    "tool": "{app}\\tools\\UEKeyHunter",
    "node": "{app}\\tools\\node\\node.exe",
    "stfinder": "{app}\\tools\\STFinder\\stfinder_v1.8.py",
    "loccheck": "{app}\\tools\\LocCheck\\loccheck_v2.4.py",
    "repak": "{app}\\tools\\repak\\repak.exe",
    "pwsh": "powershell.exe",
    "la": "{localappdata}",
    "raosig": "{app}\\tools\\raosig\\raosig_v1.4.py",
    "retoc": "{app}\\tools\\retoc\\retoc.exe",
    "outdir": "{app}\\output",
    "uasset": "F:\\模型\\UAssetGUI.exe",
    "fmodel": "F:\\模型\\UEHanHua\\FModel\\FModel.exe",
    "dumper": "F:\\模型\\jmap_dumper-x86_64-pc-windows-msvc\\jmap_dumper.exe"
  },
  "modules": [
    {
      "id": "home",
      "no": "00",
      "name": "主页",
      "sub": "欢迎 · 更新日志",
      "note": "首页",
      "ver": "V1.0",
      "status": "ready",
      "kind": "home",
      "desc": "欢迎页：打字欢迎语、署名人、右下角更新日志。",
      "tasks": [],
      "dir": false,
      "dirLabel": "游戏目录",
      "keysPanel": "none"
    },
    {
      "id": "keys",
      "no": "01",
      "name": "AES 提取",
      "sub": "exe / 代码 / 内存 / 文本 / DPAPI",
      "note": "挖 pak 密钥",
      "status": "ready",
      "tasks": [
        {
          "id": "file",
          "nav": "扫 exe",
          "title": "扫描可执行文件",
          "desc": "以滑动窗口遍历 EXE 中的 32 字节常量，命中后以 PAK 索引 SHA-1 校验。",
          "params": [
            {
              "id": "start",
              "label": "起始偏移（可空）",
              "ph": "例如 0x1000 或 4096"
            },
            {
              "id": "end",
              "label": "结束偏移（可空）",
              "ph": "留空 = 扫到文件尾"
            }
          ],
          "cmd": [
            "{node}",
            "{tool}\\scan-file.js",
            "{exe}",
            "--pak={pak}",
            "--start={p:start}",
            "--end={p:end}"
          ]
        },
        {
          "id": "code",
          "nav": "扫代码",
          "title": "扫描代码立即数",
          "desc": "反汇编提取 MOV / LEA 拼装的 32 字节常量，效率高于全文件扫描。",
          "params": [
            {
              "id": "limit",
              "label": "最多几个候选",
              "ph": "默认 200"
            },
            {
              "id": "entropy",
              "label": "只看候选（按熵排，不验 pak）",
              "type": "check"
            }
          ],
          "cmd": [
            "{node}",
            "{tool}\\scan-code.js",
            "{exe}",
            "--pak={pak}",
            "--limit={p:limit}",
            "{f:entropy:--entropy}"
          ]
        },
        {
          "id": "mem",
          "nav": "扫内存",
          "title": "扫描内存转储",
          "desc": "在进程内存转储中检索明文密钥；需先将转储放入工具目录的 mem\\。",
          "params": [
            {
              "id": "dir",
              "label": "dump 目录（空 = <游戏目录>\\mem）",
              "ph": "留空自动拼",
              "wide": true,
              "default": "{game}\\mem"
            },
            {
              "id": "fast",
              "label": "快速模式（大步长）",
              "type": "check"
            }
          ],
          "cmd": [
            "{node}",
            "{tool}\\scan-mem.js",
            "{p:dir}",
            "{f:fast:--fast}"
          ]
        },
        {
          "id": "text",
          "nav": "扫文本",
          "title": "扫描文本中的密钥",
          "desc": "在游戏目录的脚本、配置与文档中检索 64 位十六进制串，并以 PAK 索引校验。",
          "params": [
            {
              "id": "dir",
              "label": "扫描目录（空 = 游戏目录）",
              "ph": "留空就用上面的游戏目录",
              "wide": true,
              "default": "{game}"
            },
            {
              "id": "maxSize",
              "label": "单文件上限（字节）",
              "ph": "默认 4 MiB"
            }
          ],
          "cmd": [
            "{node}",
            "{tool}\\scan-text.js",
            "--dir={p:dir}",
            "--pak={pak}",
            "--maxSize={p:maxSize}"
          ]
        },
        {
          "id": "dpapi",
          "nav": "解 DPAPI",
          "title": "解密 DPAPI 缓存",
          "desc": "调用 CryptUnprotectData 解密本地缓存的密钥；部分游戏以 DPAPI 保存。",
          "params": [
            {
              "id": "root",
              "label": "缓存目录",
              "ph": "%LOCALAPPDATA%\\<游戏>\\",
              "wide": true,
              "default": "{localappdata}\\FallenDollRehost"
            },
            {
              "id": "entropy",
              "label": "附加熵（可选）",
              "ph": "例如 FallenDollRehost pak key v1",
              "wide": true
            }
          ],
          "cmd": [
            "{pwsh}",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{tool}\\scan-dpapi.ps1",
            "-Root",
            "{p:root}",
            "-Entropy",
            "{p:entropy}",
            "-Out",
            "{out}\\dpapi_cands.txt"
          ]
        },
        {
          "id": "verify",
          "nav": "校验 key",
          "title": "校验指定密钥",
          "desc": "以 64 位十六进制密钥解密 PAK 索引，SHA-1 匹配即有效。",
          "params": [
            {
              "id": "key",
              "label": "key（64 位 hex）",
              "ph": "12c37e2a…",
              "wide": true
            }
          ],
          "cmd": [
            "{node}",
            "{tool}\\verify-key.js",
            "{p:key}",
            "--pak={pak}"
          ]
        }
      ],
      "desc": "提取 PAK 的 AES-256 密钥：支持扫描可执行文件、代码立即数、内存转储、文本与 DPAPI 缓存，命中后以 PAK 索引 SHA-1 校验。",
      "ver": "v1.4",
      "dir": true,
      "dirLabel": "游戏目录",
      "keysPanel": "always"
    },
    {
      "id": "text",
      "no": "02",
      "name": "文本",
      "sub": "locres / 定位 / 字体",
      "note": "文本回灌",
      "ver": "v1.0",
      "status": "ready",
      "desc": "locres 导出与回灌、资产内 FText 与裸串定位、字体替换。",
      "tasks": [
        {
          "id": "loc_export",
          "nav": "locres 导出",
          "title": "导出 locres 为 CSV",
          "desc": "将 .locres 解析为 key、source、target 三列，供翻译与回填。",
          "params": [
            {
              "id": "locres",
              "label": "locres 文件",
              "ph": "拖一个 .locres 进来",
              "wide": true
            },
            {
              "id": "csv",
              "label": "输出 CSV",
              "ph": "留空 = 同目录同名 .csv",
              "wide": true
            },
            {
              "id": "outdir",
              "label": "输出目录",
              "ph": "留空 = 设置里的默认输出目录"
            }
          ],
          "cmd": [
            "{py}",
            "{loccheck}",
            "export",
            "{p:locres}",
            "{p:csv}"
          ],
          "outDefault": "export.csv"
        },
        {
          "id": "loc_import",
          "nav": "locres 导入",
          "title": "回灌 CSV 至 locres",
          "desc": "以底包 locres 为基础写入 CSV 译文，CSV 中新增的 key 将作为新条目写入。",
          "params": [
            {
              "id": "base",
              "label": "底包 locres",
              "ph": "原始 .locres",
              "wide": true
            },
            {
              "id": "csv",
              "label": "翻译 CSV",
              "ph": "key,source,target",
              "wide": true
            },
            {
              "id": "out",
              "label": "输出 locres",
              "ph": "留空 = <底包名>_cn.locres",
              "wide": true
            }
          ],
          "cmd": [
            "{py}",
            "{loccheck}",
            "import",
            "{p:base}",
            "{p:csv}",
            "{p:out}"
          ],
          "outDefault": ""
        },
        {
          "id": "loc_build",
          "nav": "资产生成 locres",
          "title": "由资产生成 locres",
          "desc": "扫描 .uasset / .uexp / .umap 中的 FText，生成可用的 locres，可作为模板。",
          "params": [
            {
              "id": "dir",
              "label": "资产目录",
              "ph": "例如 Content\\GameCode\\UI",
              "wide": true
            },
            {
              "id": "out",
              "label": "输出 locres",
              "ph": "留空 = 目录下 build.locres",
              "wide": true
            },
            {
              "id": "tpl",
              "label": "模板 locres（可选）",
              "ph": "留空 = 用内置头",
              "wide": true
            },
            {
              "id": "outdir",
              "label": "输出目录",
              "ph": "留空 = 设置里的默认输出目录"
            }
          ],
          "cmd": [
            "{py}",
            "{loccheck}",
            "build",
            "--from-assets",
            "{p:dir}",
            "--out",
            "{p:out}",
            "{f:tpl:--template}"
          ],
          "outDefault": "Game.locres"
        },
        {
          "id": "text_scan",
          "nav": "文本定位",
          "title": "定位文本（区分 key 与裸串）",
          "desc": "扫描资产中的 FText：A 组含 key，可由 locres 覆盖；B 组为裸串，仅能修改 uexp。输出文件路径与偏移。",
          "params": [
            {
              "id": "dir",
              "label": "资产目录（解包后的 Content）",
              "ph": "例如 Content\\GameCode\\UI",
              "wide": true
            },
            {
              "id": "out",
              "label": "输出 CSV",
              "ph": "留空 = 目录下 report.csv",
              "wide": true
            },
            {
              "id": "outdir",
              "label": "输出目录",
              "ph": "留空 = 设置里的默认输出目录"
            }
          ],
          "cmd": [
            "{py}",
            "{stfinder}",
            "scan",
            "--dir",
            "{p:dir}",
            "--out",
            "{p:out}"
          ],
          "outDefault": "report.csv"
        },
        {
          "id": "text_font",
          "nav": "字体转 ufont",
          "title": "字体转 .ufont",
          "desc": "UE4 的 .ufont 为裸字体字节，选择 ttf / otf 即可生成，输出文件名可自定义。",
          "params": [
            {
              "id": "font",
              "label": "字体文件",
              "ph": "拖 .ttf / .otf 进来"
            },
            {
              "id": "name",
              "label": "输出文件名",
              "ph": "留空 = 用字体名，自动补 .ufont"
            },
            {
              "id": "outdir",
              "label": "输出目录",
              "ph": "留空 = 设置里的默认输出目录"
            }
          ],
          "cmd": [
            "{py}",
            "{loccheck}",
            "font",
            "--font",
            "{p:font}",
            "--name",
            "{p:name}",
            "--out",
            "{p:outdir}"
          ],
          "outDefault": ""
        }
      ],
      "dir": true,
      "dirLabel": "资产目录（解包后的 Content）",
      "keysPanel": "none"
    },
    {
      "id": "sig",
      "no": "03",
      "name": "绕签名",
      "sub": "raosig · -fileopenlog",
      "note": "免签名",
      "ver": "v1.4",
      "status": "ready",
      "desc": "生成代理 DLL，为游戏命令行追加 -fileopenlog 等参数，使未签名 PAK 可被加载。",
      "tasks": [
        {
          "id": "sig_list",
          "nav": "列出可劫持 DLL",
          "title": "列出可劫持 DLL",
          "desc": "读取 EXE 导入表，按导出数量升序列出可用作代理宿主的系统 DLL。",
          "params": [],
          "cmd": [
            "{py}",
            "{raosig}",
            "list",
            "--exe",
            "{exe}"
          ]
        },
        {
          "id": "sig_auto",
          "nav": "一键装",
          "title": "一键生成并部署",
          "desc": "自动选择宿主，编译代理 DLL 并部署至 EXE 同级目录。",
          "params": [
            {
              "id": "arg",
              "label": "注入参数",
              "ph": "-fileopenlog",
              "default": "-fileopenlog"
            },
            {
              "id": "logf",
              "label": "记录引擎打开的 pak/sig/locres",
              "type": "check"
            }
          ],
          "cmd": [
            "{py}",
            "{raosig}",
            "auto",
            "--exe",
            "{exe}",
            "{j:arg:--arg}",
            "{f:logf:--log-files}"
          ]
        },
        {
          "id": "sig_build",
          "nav": "指定宿主",
          "title": "指定宿主生成",
          "desc": "指定宿主 DLL 进行生成；勾选「部署」可直接写入 EXE 目录。",
          "params": [
            {
              "id": "host",
              "label": "宿主 DLL",
              "ph": "XAPOFX1_5",
              "default": "XAPOFX1_5"
            },
            {
              "id": "arg",
              "label": "注入参数",
              "ph": "-fileopenlog",
              "default": "-fileopenlog"
            },
            {
              "id": "deploy",
              "label": "编译后直接部署",
              "type": "check",
              "default": true
            },
            {
              "id": "logf",
              "label": "记录引擎打开的 pak/sig/locres",
              "type": "check"
            }
          ],
          "cmd": [
            "{py}",
            "{raosig}",
            "build",
            "--exe",
            "{exe}",
            "--host",
            "{p:host}",
            "{j:arg:--arg}",
            "{f:deploy:--deploy}",
            "{f:logf:--log-files}"
          ]
        },
        {
          "id": "sig_uninstall",
          "nav": "卸载",
          "title": "卸载并还原",
          "desc": "删除代理 DLL，并还原已备份的原版 DLL。",
          "params": [
            {
              "id": "host",
              "label": "宿主 DLL",
              "ph": "XAPOFX1_5",
              "default": "XAPOFX1_5"
            }
          ],
          "cmd": [
            "{py}",
            "{raosig}",
            "uninstall",
            "--exe",
            "{exe}",
            "--host",
            "{p:host}"
          ]
        },
        {
          "id": "sig_clean",
          "nav": "清理残留",
          "title": "清理临时文件与残留",
          "desc": "删除 raosig 临时编译目录；指定游戏目录时一并清理已部署的代理 DLL。",
          "params": [],
          "cmd": [
            "{py}",
            "{raosig}",
            "clean",
            "--exe",
            "{exe}"
          ]
        }
      ],
      "dir": "exe",
      "dirLabel": "游戏 Shipping 路径（.exe）",
      "keysPanel": "none"
    },
    {
      "id": "unpack",
      "no": "04",
      "name": "解包",
      "sub": "repak unpack / list",
      "note": "拆 pak",
      "ver": "v0.4",
      "status": "ready",
      "desc": "普通 PAK 使用 repak 解包，IoStore（.utoc/.ucas）使用 retoc 解包；加密包需填写 AES 密钥。",
      "tasks": [
        {
          "id": "pak_ue4",
          "nav": "普通 pak",
          "title": "普通 PAK",
          "desc": "使用 repak 解包：载入后显示头信息与文件清单，开始后按挂载点 ../../../ 释放到目标目录。",
          "cmd": [
            "{repak}",
            "{k:aes:--aes-key}",
            "unpack",
            "{p:pak}",
            "-o",
            "{p:out}",
            "-s",
            "../../../",
            "{f:force:--force}"
          ],
          "params": [
            {
              "id": "pak",
              "label": "PAK 文件",
              "ph": "拖一个 .pak 进来",
              "wide": true
            },
            {
              "id": "out",
              "label": "解包目录",
              "ph": "留空 = pak 同目录 <同名>_unpack"
            },
            {
              "id": "aes",
              "label": "AES KEY（可选）",
              "ph": "32 位 hex，加密包才需要"
            },
            {
              "id": "force",
              "label": "覆盖已有文件（--force）",
              "type": "check"
            }
          ],
          "name": "普通 pak"
        },
        {
          "id": "pak_iostore",
          "name": "IoStore",
          "outDefault": "",
          "cmd": [
            "{retoc}",
            "{k:aes:--aes-key}",
            "unpack",
            "{p:utoc}",
            "{p:out}"
          ],
          "params": [
            {
              "id": "utoc",
              "label": "UTOC 容器",
              "ph": "拖一个 .utoc 进来（同目录需有 .ucas）"
            },
            {
              "id": "out",
              "label": "解包目录",
              "ph": "留空 = 同目录 <同名>_unpack"
            },
            {
              "id": "aes",
              "label": "AES KEY（可选）",
              "ph": "32 位 hex，加密包才需要"
            }
          ],
          "title": "IoStore",
          "nav": "IoStore",
          "desc": "使用 retoc unpack 解包 .utoc（需同目录下的同名 .ucas）；加密容器需填写 AES 密钥。"
        }
      ],
      "dir": false,
      "dirLabel": "游戏目录（只用来找 pak，可留空）",
      "keysPanel": "collapsible"
    },
    {
      "id": "pack",
      "no": "05",
      "name": "打包",
      "sub": "repak pack / 挂载点",
      "note": "重新打包",
      "ver": "v0.4",
      "status": "ready",
      "desc": "普通 PAK 使用 repak 打包（V8B / V11），IoStore 使用 retoc to-zen 打包；加密包需填写 AES 密钥。",
      "tasks": [
        {
          "id": "pack_ue4",
          "nav": "普通 pak",
          "title": "普通 PAK",
          "desc": "使用 repak 打包：输入目录的顶层即挂载点下的内容，默认前缀 ../../../。",
          "cmd": [
            "{repak}",
            "pack",
            "{p:dir}",
            "{p:out}",
            "-m",
            "{p:mount}",
            "--version",
            "{p:version}",
            "{f:comp:--compression}"
          ],
          "params": [
            {
              "id": "dir",
              "label": "输入目录",
              "ph": "要打包的文件夹",
              "wide": true
            },
            {
              "id": "out",
              "label": "输出 PAK",
              "ph": "留空 = 目录同级 <目录名>.pak"
            },
            {
              "id": "mount",
              "label": "挂载点",
              "ph": "../../../"
            },
            {
              "id": "version",
              "label": "PAK 版本",
              "ph": "V8B / V11"
            },
            {
              "id": "comp",
              "label": "压缩（可选）",
              "ph": "Zlib / Oodle / 留空不压",
              "wide": true
            }
          ],
          "name": "普通 pak"
        },
        {
          "id": "pack_iostore",
          "name": "IoStore",
          "outDefault": "",
          "cmd": [
            "{retoc}",
            "{k:aes:--aes-key}",
            "to-zen",
            "--version",
            "{p:version}",
            "{p:dir}",
            "{p:out}"
          ],
          "params": [
            {
              "id": "dir",
              "label": "输入目录",
              "ph": "要打包的文件夹（含 .uasset/.uexp/.ubulk）"
            },
            {
              "id": "out",
              "label": "输出 UTOC",
              "ph": "留空 = 目录同级 <目录名>.utoc"
            },
            {
              "id": "version",
              "label": "引擎版本",
              "ph": "UE4_26",
              "default": "UE4_26"
            },
            {
              "id": "aes",
              "label": "AES KEY（可选）",
              "ph": "32 位 hex，要加密才填"
            }
          ],
          "title": "IoStore",
          "nav": "IoStore",
          "desc": "使用 retoc to-zen 将已 cook 的目录打包为 .utoc / .ucas / .pak；引擎版本按 UE4_26、UE5_3 填写。"
        }
      ],
      "dir": false,
      "dirLabel": "游戏目录",
      "keysPanel": "none"
    },
    {
      "id": "uasset",
      "name": "资产查看",
      "ver": "v1.1.0",
      "status": "ready",
      "desc": "启动 UAssetGUI（v1.1.0），查看与导出 .uasset 资产及属性树；下方列出资产路径内的 UE 资产，并可直接查看 .locres 内容。",
      "tasks": [
        {
          "id": "launch_uasset",
          "nav": "启动",
          "title": "启动 UAssetGUI",
